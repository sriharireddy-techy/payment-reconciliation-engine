# Copy this file to .env and fill in your own values. .env is ignored by Git.
#
# Oracle FreeSQL: sign in at https://freesql.com with the account that owns the
# 10 project tables, open "Schema Connection Details" and copy the values below.
# Generate a connection password there (it is not your Oracle account password).

ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=

# Optional: instead of HOST/PORT/SERVICE_NAME, paste a full connect string
# (EZCONNECT "host:port/service" or a TNS descriptor). Leave empty normally.
ORACLE_DSN=

# Connection pool (concurrency lab uses up to DB_POOL_MAX sessions at once).
DB_POOL_MIN=1
DB_POOL_MAX=6

# Failure simulation hooks are refused unless this is true. Keep it false
# except while demonstrating rollback.
ENABLE_FAILURE_SIMULATION=false

# Upper limit for the concurrency lab.
CONCURRENCY_MAX_REQUESTS=25
